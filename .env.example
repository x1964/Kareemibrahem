# Public site URL used for canonical URLs, Open Graph, sitemap, and robots.txt.
# Set this to your production domain once confirmed (e.g. https://yourdomain.com)
NEXT_PUBLIC_SITE_URL=

# Web3Forms access key for the contact form backend.
# Get a free key at https://web3forms.com — submissions are delivered
# to the email you register with. Without it, forms fall back to mailto.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

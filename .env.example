# Public site URL used for canonical URLs, Open Graph, sitemap, and robots.txt.
# Set this to your production domain once confirmed (e.g. https://yourdomain.com)
NEXT_PUBLIC_SITE_URL=

# Resend API key for the contact form backend.
# Without it, the contact form falls back to opening the visitor's email client.
# Get a key at https://resend.com
RESEND_API_KEY=

# Optional: verified sender address for Resend (must be a domain verified in Resend)
# CONTACT_FROM_EMAIL="Kareem Ibrahem <hello@yourdomain.com>"
